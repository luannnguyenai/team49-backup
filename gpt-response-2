## 3. Current benchmark is not enough for verified correctness

[problem]
Notebook currently has:

```text
1. test_data[:5] qualitative generation
2. MMLU/GSM8K public benchmark
```

[cause]
This does not prove the model is correct on the project's verified course dataset.

MMLU/GSM8K only check general-capability regression. They do not measure CS224n/CS231n/CS230 course-specific correctness.

[fix]
Add Tier 1 verified domain MCQ benchmark.

Requirements:

```text
- Use question_bank.jsonl
- Use held-out lectures only
- Use verified/pass items only if metadata exists
- Prompt model to return A/B/C/D only
- Compute accuracy overall and per course
- Save predictions and summary to Kaggle output
```

Recommended benchmark cell:

```python
import re
from collections import Counter, defaultdict

def normalize_status(x):
    return str(x or "").strip().lower()

def is_verified_item(item):
    status = normalize_status(item.get("review_status"))
    gate = item.get("qa_gate_passed")

    status_ok = (
        not status
        or status in {"verified", "approved", "pass", "passed", "accepted", "ok"}
    )
    gate_ok = gate is not False
    return status_ok and gate_ok

def extract_letter(text):
    text = (text or "").strip().upper()
    m = re.search(r"\b([ABCD])\b", text)
    return m.group(1) if m else "X"

verified_items = [m for m in mcqs if is_verified_item(m)]
bench_items = [
    m for m in verified_items
    if m.get("lecture_id") in test_lectures
]

print(f"Verified items: {len(verified_items)}")
print(f"Benchmark held-out items: {len(bench_items)}")
print("Review status distribution:", Counter(normalize_status(m.get("review_status")) for m in mcqs))
print("QA gate distribution:", Counter(m.get("qa_gate_passed") for m in mcqs))

predictions = []
correct = 0
by_course = defaultdict(lambda: [0, 0])

for item in bench_items:
    choices = "\n".join(
        f"{chr(65+i)}. {choice}"
        for i, choice in enumerate(item["choices"])
    )
    prompt = (
        f"[{item['course_id']}]\n"
        f"Question: {item['question']}\n\n"
        f"Choices:\n{choices}\n\n"
        "Return only the correct letter: A, B, C, or D."
    )

    resp = generate([{"role": "user", "content": prompt}], max_new_tokens=8)
    pred = extract_letter(resp)
    gold = chr(65 + int(item["answer_index"]))
    ok = pred == gold

    correct += int(ok)
    by_course[item["course_id"]][0] += int(ok)
    by_course[item["course_id"]][1] += 1

    predictions.append({
        "item_id": item.get("item_id"),
        "course_id": item.get("course_id"),
        "lecture_id": item.get("lecture_id"),
        "question": item.get("question"),
        "gold": gold,
        "pred": pred,
        "raw_response": resp,
        "correct": ok,
    })

overall_acc = correct / max(1, len(bench_items))
print(f"Domain verified MCQ accuracy: {correct}/{len(bench_items)} = {overall_acc:.1%}")

for course, (c, n) in sorted(by_course.items()):
    print(f"{course}: {c}/{n} = {c/max(1,n):.1%}")

eval_dir = OUT_ROOT / "eval"
eval_dir.mkdir(parents=True, exist_ok=True)

with open(eval_dir / "domain_verified_predictions.jsonl", "w", encoding="utf-8") as f:
    for row in predictions:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")

with open(eval_dir / "domain_verified_summary.json", "w", encoding="utf-8") as f:
    json.dump({
        "benchmark_items": len(bench_items),
        "correct": correct,
        "accuracy": overall_acc,
        "by_course": {
            course: {"correct": c, "total": n, "accuracy": c / max(1, n)}
            for course, (c, n) in by_course.items()
        },
    }, f, ensure_ascii=False, indent=2)
```

