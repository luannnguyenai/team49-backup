  <diagram id="QXGz41cb3IcDSdetpg3u" name="Page-2">
    <mxGraphModel dx="774" dy="425" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="&#xa;&#xa;&lt;a class=&quot;back&quot; href=&quot;index.html&quot;&gt;← Architecture Hub&lt;/a&gt;&#xa;&#xa;&lt;div class=&quot;page-header&quot;&gt;&#xa;  &lt;h1&gt;Request Lifecycle&lt;/h1&gt;&#xa;  &lt;p&gt;Two key flows: standard page load vs. AI Tutor chat with agentic RAG&lt;/p&gt;&#xa;&lt;/div&gt;&#xa;&#xa;&lt;div class=&quot;flows&quot;&gt;&#xa;&#xa;  &#xa;  &lt;div class=&quot;flow&quot;&gt;&#xa;    &lt;div class=&quot;flow-title&quot;&gt;🖥 Flow 1 — Page Load (SSR)&#xa;      &lt;span&gt;Browser requests a course or learning unit page&lt;/span&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;1&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;GET /courses/:id&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;HTTPS request to CloudFront / ALB&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-orange&quot;&gt;2&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-network&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;ALB&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Route → Next.js Frontend (ECS)&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Path-based routing&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;3&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-frontend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Next.js Frontend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Server-side fetch → FastAPI /api/courses&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;RSC data fetch with auth cookie&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;4&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-backend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;FastAPI Backend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Query PostgreSQL + Redis cache&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Course data, learner progress, mastery&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;5&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Receive rendered HTML + hydrate&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Full page with course, progress, planner&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;  &lt;/div&gt;&#xa;&#xa;  &#xa;  &lt;div class=&quot;flow&quot;&gt;&#xa;    &lt;div class=&quot;flow-title&quot;&gt;🤖 Flow 2 — AI Tutor Chat (Agentic RAG)&#xa;      &lt;span&gt;Learner sends a question to AI Tutor&lt;/span&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;1&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;POST /api/agent/chat&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;User message + session context&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;2&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-backend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;FastAPI Backend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;PII Sanitize → Guardrail Router&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Qwen3.5-0.8B LoRA · SAFE / HARMFUL check&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-purple&quot;&gt;3&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-ai&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;LangGraph Agent&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Smart Router → ReAct graph&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;COMPLEX: enter agent graph with tools&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-purple&quot;&gt;4&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-ai&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Agent Tools&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;RAG search pgvector → retrieve transcript chunks&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Optionally: Python Sandbox or Semantic Scholar&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-purple&quot;&gt;5&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-ai&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Answer Generator&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Qwen3.5-4B LoRA generates grounded answer&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Citation grounded · No hallucination policy&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-green&quot;&gt;6&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-stream&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;SSE Stream&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Token-by-token stream → Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Langfuse trace logged · Redis updates session&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;  &lt;/div&gt;&#xa;&#xa;&lt;/div&gt;&#xa;&#xa;&#xa;" link="&#xa;&#xa;&lt;a class=&quot;back&quot; href=&quot;index.html&quot;&gt;← Architecture Hub&lt;/a&gt;&#xa;&#xa;&lt;div class=&quot;page-header&quot;&gt;&#xa;  &lt;h1&gt;Request Lifecycle&lt;/h1&gt;&#xa;  &lt;p&gt;Two key flows: standard page load vs. AI Tutor chat with agentic RAG&lt;/p&gt;&#xa;&lt;/div&gt;&#xa;&#xa;&lt;div class=&quot;flows&quot;&gt;&#xa;&#xa;  &#xa;  &lt;div class=&quot;flow&quot;&gt;&#xa;    &lt;div class=&quot;flow-title&quot;&gt;🖥 Flow 1 — Page Load (SSR)&#xa;      &lt;span&gt;Browser requests a course or learning unit page&lt;/span&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;1&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;GET /courses/:id&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;HTTPS request to CloudFront / ALB&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-orange&quot;&gt;2&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-network&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;ALB&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Route → Next.js Frontend (ECS)&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Path-based routing&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;3&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-frontend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Next.js Frontend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Server-side fetch → FastAPI /api/courses&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;RSC data fetch with auth cookie&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;4&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-backend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;FastAPI Backend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Query PostgreSQL + Redis cache&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Course data, learner progress, mastery&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;5&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;Receive rendered HTML + hydrate&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Full page with course, progress, planner&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;  &lt;/div&gt;&#xa;&#xa;  &#xa;  &lt;div class=&quot;flow&quot;&gt;&#xa;    &lt;div class=&quot;flow-title&quot;&gt;🤖 Flow 2 — AI Tutor Chat (Agentic RAG)&#xa;      &lt;span&gt;Learner sends a question to AI Tutor&lt;/span&gt;&#xa;    &lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-blue&quot;&gt;1&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-browser&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;Browser&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;POST /api/agent/chat&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;User message + session context&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;connector-body&quot;&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;    &lt;div class=&quot;step&quot;&gt;&#xa;      &lt;div class=&quot;step-num num-red&quot;&gt;2&lt;/div&gt;&#xa;      &lt;div class=&quot;step-body c-backend&quot;&gt;&#xa;        &lt;div class=&quot;step-actor&quot;&gt;FastAPI Backend&lt;/div&gt;&#xa;        &lt;div class=&quot;step-action&quot;&gt;PII Sanitize → Guardrail Router&lt;/div&gt;&#xa;        &lt;div class=&quot;step-note&quot;&gt;Qwen3.5-0.8B LoRA · SAFE / HARMFUL check&lt;/div&gt;&#xa;      &lt;/div&gt;&#xa;    &lt;/div&gt;&#xa;    &lt;div class=&quot;connector&quot;&gt;&lt;div class=&quot;connector-num&quot;&gt;&lt;div class=&quot;connector-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div c