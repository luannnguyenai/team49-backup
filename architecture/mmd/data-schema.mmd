flowchart LR
    subgraph CONTENT["📚 Canonical Content (Knowledge Graph)"]
        direction TB
        KP["concepts_kp\n─────────────\nkp_id · title\ncourse_id · description"]
        UNITS["units\n─────────────\nunit_id · title\ncanonical_course_id · phase"]
        UKM["unit_kp_map\n(weight · is_primary)"]
        QB["question_bank\n─────────────\nitem_id · stem · options\ncorrect_answer · source_ref"]
        CAL["item_calibration\n─────────────\ndiscrimination · difficulty\nguessing · is_calibrated"]
        IPHASE["item_phase_map\nphase · depth_level"]
        IKPM["item_kp_map\n(weight)"]
        PREREQ["prerequisite_edges\n─────────────\nfrom_kp_id → to_kp_id\nscore · model_source"]

        KP <--> UKM
        UNITS <--> UKM
        UNITS --> QB
        QB --> CAL
        QB --> IPHASE
        QB <--> IKPM
        KP <--> IKPM
        KP --> PREREQ
    end

    subgraph PRODUCT["🏫 Product Shell (Course Structure)"]
        direction TB
        COURSES["courses\n─────────────\nslug · title\ncanonical_course_id"]
        SECTIONS["course_sections\norder_index"]
        LU["learning_units\n─────────────\ncanonical_unit_id\nunit_type · order_index"]
        ASSETS["course_assets\nasset_type · s3_key\ncloudfront_url"]
        LECTURES["lectures\nyoutube_id · duration_s"]
        TRANSCRIPT["transcript_lines\nstart_s · end_s\ncontent · vector embedding"]

        COURSES --> SECTIONS --> LU --> ASSETS
        LU --> LECTURES --> TRANSCRIPT
    end

    subgraph LEARNER["👤 Learner State"]
        direction TB
        USERS["users\n─────────────\nemail · role"]
        SESSIONS["sessions\ncanonical_phase"]
        INTERACT["interactions\n─────────────\ncanonical_item_id\ncorrect · latency_ms · is_synthetic"]
        MASTERY["learner_mastery_kp\n─────────────\nkp_id · theta_mu · theta_sigma\nn_observations · updated_at\n\n⟹ mastery_lcb = sigmoid(\n  (θ_mu - θ_sigma) / √(1+θ_sigma²)\n)"]
        PROGRESS["learning_progress_records\n─────────────\nlearning_unit_id · status\nvideo_progress_s · last_activity"]
        WAIVED["waived_units\nmastery_lcb_at_waive"]
        GOALS["goal_preferences\nselected_course_ids\nknown_unit_ids"]

        USERS --> SESSIONS --> INTERACT
        USERS --> MASTERY
        USERS --> PROGRESS
        USERS --> WAIVED
        USERS --> GOALS
    end

    subgraph PLANNER["🧭 Planner + Agent State"]
        direction TB
        PSS["planner_session_state\n─────────────\ncurrent_unit_id · current_stage\ncurrent_progress · items_remaining\nlast_activity"]
        PH["plan_history\nrecommended_units\ncreated_at"]
        RL["rationale_log\nwhy next unit was chosen"]
        AGR["agent_graph_runs\n─────────────\nthread_id · status\ngraph_state (checkpointer)"]
        APA["agent_pending_actions\naction_id · expires_at\nstatus: awaiting/approved/rejected"]
        ARP["agent_response_payloads\nincoming_message_id\npayload_json (idempotency)"]

        PSS
        PH
        RL
        AGR --> APA
        AGR --> ARP
    end

    CONTENT -->|"item_calibration\nprerequisite graph"| LEARNER
    LEARNER -->|"mastery_lcb per KP\nprogress + goals"| PLANNER
    PRODUCT -->|"canonical_unit_id\nbridges product ↔ canonical"| CONTENT
