        <!-- Flow 2 Steps -->
        <mxCell id="f2s1" value="&lt;b&gt;1 · Browser&lt;/b&gt; — POST /api/agent/chat&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;User message + session context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#4A90D9;fontColor=#1B4F8A;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
          <mxGeometry x="40" y="40" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f2s2" value="&lt;b&gt;2 · FastAPI Backend&lt;/b&gt; — PII Sanitize → Guardrail Router&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Qwen3.5-0.8B LoRA · SAFE / HARMFUL check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
          <mxGeometry x="40" y="150" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f2s3" value="&lt;b&gt;3 · LangGraph Agent&lt;/b&gt; — Smart Router → ReAct graph&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;COMPLEX: enter agent graph with tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#8E44AD;fontColor=#5B2C6F;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
          <mxGeometry x="40" y="260" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f2s4" value="&lt;b&gt;4 · Agent Tools&lt;/b&gt; — RAG search pgvector → retrieve transcript chunks&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Optionally: Python Sandbox or Semantic Scholar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#8E44AD;fontColor=#5B2C6F;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
          <mxGeometry x="40" y="370" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f2s5" value="&lt;b&gt;5 · Answer Generator&lt;/b&gt; — Qwen3.5-4B LoRA generates grounded answer&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Citation grounded · No hallucination policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#8E44AD;fontColor=#5B2C6F;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
          <mxGeometry x="40" y="480" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f2s6" value="&lt;b&gt;6 · SSE Stream&lt;/b&gt; — Token-by-token stream → Browser&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Langfuse trace logged · Redis updates session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#27AE60;fontColor=#065F46;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim2">
