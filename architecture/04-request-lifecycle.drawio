  <diagram id="reqlifecycle" name="Request Lifecycle">
    <mxGraphModel dx="1366" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══ FLOW 1: PAGE LOAD (SSR) ═══ -->
        <mxCell id="title1" value="🖥  Flow 1 — Page Load (SSR)" style="text;html=1;align=center;fontStyle=1;fontSize=14;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="560" height="30" as="geometry"/>
        </mxCell>

        <!-- Swimlane container for Flow 1 -->
        <mxCell id="swim1" value="" style="swimlane;startSize=0;fillColor=#F9FAFB;strokeColor=#E5E7EB;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="640" height="960" as="geometry"/>
        </mxCell>

        <!-- Flow 1 Steps -->
        <mxCell id="f1s1" value="&lt;b&gt;1 · Browser&lt;/b&gt; — GET /courses/:id&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;HTTPS to CloudFront / ALB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#4A90D9;fontColor=#1B4F8A;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim1">
          <mxGeometry x="40" y="40" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f1s2" value="&lt;b&gt;2 · ALB&lt;/b&gt; — Route → Next.js Frontend (ECS)&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Path-based routing &lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontColor=#7D3C00;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim1">
          <mxGeometry x="40" y="150" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f1s3" value="&lt;b&gt;3 · Next.js Frontend&lt;/b&gt; — Server-side fetch → FastAPI /api/courses&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;RSC data fetch with auth cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#E7500A;fontColor=#7B2A0A;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim1">
          <mxGeometry x="40" y="260" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f1s4" value="&lt;b&gt;4 · FastAPI Backend&lt;/b&gt; — Query PostgreSQL + Redis cache&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Course data · learner progress · mastery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#E7500A;fontColor=#7B2A0A;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim1">
          <mxGeometry x="40" y="370" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f1s5" value="&lt;b&gt;5 · Browser&lt;/b&gt; — Receive rendered HTML + hydrate&lt;br&gt;&lt;font size='2' color='#6B7280'&gt;Full page with course, progress, planner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#4A90D9;fontColor=#1B4F8A;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="swim1">
