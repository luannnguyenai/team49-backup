        <mxCell id="title2" value="🤖  Flow 2 — AI Tutor Chat (Agentic RAG)" style="text;html=1;align=center;fontStyle=1;fontSize=14;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="954" y="40" width="640" height="30" as="geometry"/>
