# Auto-detect text files and normalize line endings
* text=auto

# Default encoding
* working-tree-encoding=UTF-8

# Source code
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.jsx    text eol=lf
*.py     text eol=lf
*.java   text eol=lf
*.go     text eol=lf
*.rs     text eol=lf
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.cs     text eol=lf

# Config / data files
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.xml    text eol=lf
*.env    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf

# Windows scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary