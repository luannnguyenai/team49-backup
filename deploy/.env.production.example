# =============================================================================
# deploy/.env.production.example
# Production-oriented template for Railway / hosted deploys.
# Set real values in the platform dashboard, not in git.
# =============================================================================

# ── Backend service (FastAPI) ────────────────────────────────────────────────
# Railway Postgres usually provides postgresql://... ; convert to asyncpg form.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://default:PASSWORD@HOST:PORT

SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
ASSET_URL_EXPIRE_SECONDS=900

DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["https://your-frontend-domain"]
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano
GEMINI_REQUESTS_PER_MINUTE=15
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional observability
# Preferred variable per current LangFuse SDK/docs.
# Change the base URL if your LangFuse project is in a non-EU region or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Backward-compatible alias for older local configs / code paths
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=https://your-prometheus-host

# Admin / recommendation config
KG_PHASE=0
ADMIN_TOKEN=
KG_MASTERY_SKIP_THRESHOLD=0.7
KG_MASTERY_REVIEW_THRESHOLD=0.4
KG_SHORTCUT_MASTERY_THRESHOLD=0.8
KG_SHORTCUT_HOURS_FACTOR=0.4
KG_PATH_WEEK_BUFFER=0.2
KG_BUCKET_WEIGHTS={"easy":1.0,"medium":1.3,"hard":1.6}
KG_RECSYS_WEIGHTS={"mastery_gap":0.35,"prereq_ready":0.25,"transfer_boost":0.2,"goal_distance":0.15,"freshness":0.05}

WRITE_GOAL_PREFERENCES_ENABLED=true
WRITE_LEARNER_MASTERY_KP_ENABLED=true
WRITE_WAIVED_UNITS_ENABLED=true
WRITE_PLANNER_AUDIT_ENABLED=true
READ_GOAL_PREFERENCES_ENABLED=true
READ_LEARNER_MASTERY_KP_ENABLED=true
READ_CANONICAL_QUESTIONS_ENABLED=true
WRITE_CANONICAL_INTERACTIONS_ENABLED=true
READ_CANONICAL_PLANNER_ENABLED=true

COLD_START_MODE=spread_by_prior
IRT_MIN_AVG_RESPONSES=200
IRT_MIN_CALIBRATED_RATIO=0.8
IRT_MAX_MEDIAN_SE_B=0.3
IRT_EXPOSURE_CAP_HOURS=24
IRT_USE_2PL=false

# ── Frontend service (Next.js) ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend-domain
# Optional: set when server-side Next.js should call a private/internal backend URL.
API_INTERNAL_URL=https://your-backend-domain
NEXT_PUBLIC_GRAFANA_HOST=https://your-grafana-domain
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# ───── Service `postgres` (custom image pgvector/pgvector:pg16) ─

POSTGRES_USER=ailearning
POSTGRES_PASSWORD=replace_with_openssl_rand_base64_24
POSTGRES_DB=ai_learning
PGDATA=/var/lib/postgresql/data/pgdata

# ───── AWS CLI local (KHÔNG set trên Railway) ───────────────
# Dùng để upload video lên S3, set qua `aws configure`:
#   aws configure
#   AWS Access Key ID:     <admin key, không phải IAM user backend>
#   AWS Secret Access Key: <admin secret>
#   Default region:        us-east-1
#   Default output format: json
