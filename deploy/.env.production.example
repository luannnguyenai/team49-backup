# Application
NODE_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Public URLs
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=["https://app.example.com"]

# Database
POSTGRES_DB=ai_learning
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+asyncpg://app_user:replace_me@db-host:5432/ai_learning

# Redis
REDIS_PASSWORD=replace_me
REDIS_URL=redis://:replace_me@redis-host:6379/0

# Auth / Security
SECRET_KEY=replace_with_64_hex_or_equivalent_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5

# LLM Provider
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# DB Tuning
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional ports if directly mapped
BACKEND_PORT=8000
FRONTEND_PORT=3000
