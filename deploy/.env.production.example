# ============================================================
# Railway demo env template
# ------------------------------------------------------------
# KHÔNG commit file .env thật. Set qua Railway dashboard
# (Service → Variables). File này chỉ để tham khảo tên biến.
# ============================================================

# ---- Backend service ---------------------------------------

# Railway Postgres cấp dạng postgresql://... — đổi prefix thủ công:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB

# Railway Redis plugin cấp sẵn:
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Auth / security
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5

# CORS — thay bằng domain Railway thật của frontend
CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# LLM provider (chọn 1)
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Runtime
DEBUG=false
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Frontend service --------------------------------------

NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NODE_ENV=production
