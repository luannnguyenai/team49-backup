# ============================================================
# Demo deploy env template — Railway + AWS S3
# ------------------------------------------------------------
# KHÔNG commit file .env thật. Set qua Railway dashboard
# (Service → Variables / Build Args). File này chỉ tham chiếu.
# Xem ENVIRONMENT_MATRIX.md cho mapping chi tiết từng service.
# ============================================================

# ───── Service `backend` ────────────────────────────────────

# Database — sửa scheme thành asyncpg, host dùng Railway private domain
DATABASE_URL=postgresql+asyncpg://ailearning:CHANGE_ME@postgres.railway.internal:5432/ai_learning

# Redis — reference plugin Railway
REDIS_URL=${{Redis.REDIS_URL}}

# Auth / security
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5

# CORS — origin frontend Railway sau khi generate domain
CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# LLM provider (chọn 1)
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Runtime
DEBUG=false
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# AWS S3 — cho video presigned URL redirect
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=us-east-1
S3_VIDEO_BUCKET=ai-learning-videos-demo
S3_PRESIGNED_URL_TTL=3600

# ───── Service `frontend` ───────────────────────────────────
# NEXT_PUBLIC_API_URL phải set ở cả Build Args VÀ Variables.
# Build Args bake vào bundle JS; Variables để runtime SSR đọc.

NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
API_INTERNAL_URL=http://backend.railway.internal:8000
NODE_ENV=production

# ───── Service `postgres` (custom image pgvector/pgvector:pg16) ─

POSTGRES_USER=ailearning
POSTGRES_PASSWORD=replace_with_openssl_rand_base64_24
POSTGRES_DB=ai_learning
PGDATA=/var/lib/postgresql/data/pgdata

# ───── AWS CLI local (KHÔNG set trên Railway) ───────────────
# Dùng để upload video lên S3, set qua `aws configure`:
#   aws configure
#   AWS Access Key ID:     <admin key, không phải IAM user backend>
#   AWS Secret Access Key: <admin secret>
#   Default region:        us-east-1
#   Default output format: json
