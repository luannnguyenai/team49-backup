# =============================================================================
# deploy/.env.production.example
# Production-oriented template for Render + AWS asset deploys.
# Set real values in Render dashboard / AWS console, NOT in git.
# =============================================================================

# ── Backend service (FastAPI on Render) ──────────────────────────────────────
# Render Postgres provides postgresql://... ; convert to asyncpg form for SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://default:PASSWORD@HOST:PORT
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth / security
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
EMAIL_FROM=
FRONTEND_BASE_URL=https://your-frontend.onrender.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
CORS_ORIGINS=["https://your-frontend.onrender.com"]

# App / runtime
DEBUG=false
LOG_LEVEL=INFO
MODEL_PROVIDER=openai
DEFAULT_MODEL=
FAST_MODEL=
GEMINI_REQUESTS_PER_MINUTE=15
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Asset delivery (AWS S3 + CloudFront)
ASSET_STORAGE_PROVIDER=s3
ASSET_URL_EXPIRE_SECONDS=900
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=a20-course-assets-prod
AWS_S3_PREFIX=courses
CLOUDFRONT_DOMAIN=your-distribution.cloudfront.net
# Only required if signed CloudFront URL is enabled
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=

# Admin / recommendation config
KG_PHASE=0
ADMIN_TOKEN=
KG_MASTERY_SKIP_THRESHOLD=0.7
KG_MASTERY_REVIEW_THRESHOLD=0.4
KG_SHORTCUT_MASTERY_THRESHOLD=0.8
KG_SHORTCUT_HOURS_FACTOR=0.4
KG_PATH_WEEK_BUFFER=0.2
KG_BUCKET_WEIGHTS={"easy":1.0,"medium":1.3,"hard":1.6}
KG_RECSYS_WEIGHTS={"mastery_gap":0.35,"prereq_ready":0.25,"transfer_boost":0.2,"goal_distance":0.15,"freshness":0.05}

WRITE_GOAL_PREFERENCES_ENABLED=true
WRITE_LEARNER_MASTERY_KP_ENABLED=true
WRITE_WAIVED_UNITS_ENABLED=true
WRITE_PLANNER_AUDIT_ENABLED=true
READ_GOAL_PREFERENCES_ENABLED=true
READ_LEARNER_MASTERY_KP_ENABLED=true
READ_CANONICAL_QUESTIONS_ENABLED=true
WRITE_CANONICAL_INTERACTIONS_ENABLED=true
READ_CANONICAL_PLANNER_ENABLED=true

COLD_START_MODE=spread_by_prior
IRT_MIN_AVG_RESPONSES=200
IRT_MIN_CALIBRATED_RATIO=0.8
IRT_MAX_MEDIAN_SE_B=0.3
IRT_EXPOSURE_CAP_HOURS=24
IRT_USE_2PL=false

# ── Frontend service (Next.js on Render) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# Optional: server-side Next.js calls to private/internal backend URL.
API_INTERNAL_URL=https://your-backend.onrender.com
NEXT_PUBLIC_GRAFANA_HOST=
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# ── AWS CLI local/admin (DO NOT set admin credentials on Render runtime) ─────
# Use on local/admin machine to upload assets to S3:
#   aws configure
#   AWS Access Key ID:     <admin key>
#   AWS Secret Access Key: <admin secret>
#   Default region:        ap-southeast-1   (match AWS_REGION above)
#   Default output format: json
#   aws s3 sync ./data/courses s3://<bucket>/courses --delete
