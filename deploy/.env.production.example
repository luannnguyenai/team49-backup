# =============================================================================
# deploy/.env.production.example
# AWS-first simple managed production template.
# Set real values in Amplify / App Runner / Secrets Manager, NOT in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend service: AWS App Runner `a20-backend`
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS_HOST:5432/DB
REDIS_URL=redis://ELASTICACHE_HOST:6379/0
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
PORT=8000

# Auth / security
SECRET_KEY=replace_with_secure_random_64_hex_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
EMAIL_FROM=noreply@example.com
FRONTEND_BASE_URL=https://app.example.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
CORS_ORIGINS=["https://app.example.com"]

# App / LLM runtime
DEBUG=false
LOG_LEVEL=INFO
MODEL_PROVIDER=openai
DEFAULT_MODEL=
FAST_MODEL=
GEMINI_REQUESTS_PER_MINUTE=15
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Asset delivery: AWS S3 + CloudFront
ASSET_STORAGE_PROVIDER=s3
ASSET_URL_EXPIRE_SECONDS=900
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=a20-course-assets-prod
AWS_S3_PREFIX=courses
CLOUDFRONT_DOMAIN=cdn.example.com
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=

# Admin / recommendation config
KG_PHASE=0
ADMIN_TOKEN=
KG_MASTERY_SKIP_THRESHOLD=0.7
KG_MASTERY_REVIEW_THRESHOLD=0.4
KG_SHORTCUT_MASTERY_THRESHOLD=0.8
KG_SHORTCUT_HOURS_FACTOR=0.4
KG_PATH_WEEK_BUFFER=0.2
KG_BUCKET_WEIGHTS={"easy":1.0,"medium":1.3,"hard":1.6}
KG_RECSYS_WEIGHTS={"mastery_gap":0.35,"prereq_ready":0.25,"transfer_boost":0.2,"goal_distance":0.15,"freshness":0.05}

WRITE_GOAL_PREFERENCES_ENABLED=true
WRITE_LEARNER_MASTERY_KP_ENABLED=true
WRITE_WAIVED_UNITS_ENABLED=true
WRITE_PLANNER_AUDIT_ENABLED=true
READ_GOAL_PREFERENCES_ENABLED=true
READ_LEARNER_MASTERY_KP_ENABLED=true
READ_CANONICAL_QUESTIONS_ENABLED=true
WRITE_CANONICAL_INTERACTIONS_ENABLED=true
READ_CANONICAL_PLANNER_ENABLED=true

COLD_START_MODE=spread_by_prior
IRT_MIN_AVG_RESPONSES=200
IRT_MIN_CALIBRATED_RATIO=0.8
IRT_MAX_MEDIAN_SE_B=0.3
IRT_EXPOSURE_CAP_HOURS=24
IRT_USE_2PL=false

# -----------------------------------------------------------------------------
# Frontend app: AWS Amplify Hosting `a20-frontend`
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
API_INTERNAL_URL=https://api.example.com
NEXT_PUBLIC_GRAFANA_HOST=
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# -----------------------------------------------------------------------------
# Native auto deploy settings to record in AWS console
# -----------------------------------------------------------------------------
APP_RUNNER_SERVICE_NAME=a20-backend
APP_RUNNER_SOURCE_BRANCH=main
APP_RUNNER_HEALTH_PATH=/health
APP_RUNNER_AUTO_DEPLOY=true

AMPLIFY_APP_NAME=a20-frontend
AMPLIFY_APP_ROOT=frontend
AMPLIFY_SOURCE_BRANCH=main
AMPLIFY_AUTO_DEPLOY=true

# Terraform infra automation
AWS_TERRAFORM_ROLE_ARN=arn:aws:iam::123456789012:role/github-a20-prod-terraform
TERRAFORM_STATE_BUCKET=a20-terraform-state-prod
TERRAFORM_STATE_KEY=a20/prod/terraform.tfstate

# -----------------------------------------------------------------------------
# Optional later GitHub Actions deploy values for ECR + OIDC
# -----------------------------------------------------------------------------
AWS_ACCOUNT_ID=123456789012
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/github-a20-prod-deploy
ECR_BACKEND_REPOSITORY=a20-backend
APP_RUNNER_BACKEND_SERVICE_ARN=arn:aws:apprunner:ap-southeast-1:123456789012:service/a20-backend/service-id
PRODUCTION_BACKEND_URL=https://api.example.com
PRODUCTION_FRONTEND_URL=https://app.example.com

# Local/admin AWS CLI usage:
# aws sts get-caller-identity
# aws s3 sync ./data/courses s3://a20-course-assets-prod/courses --delete
