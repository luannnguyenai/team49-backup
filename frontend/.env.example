# =============================================================================
# frontend/.env.example — Copy to .env.local and fill in values.
# NEVER commit .env.local to version control!
# =============================================================================

# ── API endpoints ─────────────────────────────────────────────────────────────
# Client-side calls use NEXT_PUBLIC_API_URL.
# Server-side calls prefer API_INTERNAL_URL when available.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
SEMANTIC_SCHOLAR_API_KEY=s2k-3Rip4TY0E1Y6G5AvuEZnUrxlx4XC6BMixH3ZNLvL
GUARDRAIL_ROUTER_BASE_URL=https://router.a20-app-049.io.vn/v1
GUARDRAIL_ROUTER_MODEL=guardrail-router-merged
GUARDRAIL_ROUTER_API_KEY=aivntop1gogo

# ── Admin observability embeds ───────────────────────────────────────────────
NEXT_PUBLIC_GRAFANA_HOST=http://localhost:3001
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com

# ── Next.js runtime ───────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# Optional local test overrides
FRONTEND_PORT=3000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
