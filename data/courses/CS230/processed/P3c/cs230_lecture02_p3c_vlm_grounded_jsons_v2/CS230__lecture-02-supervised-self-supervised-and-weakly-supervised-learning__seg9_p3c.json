      "question": "Why is next-token prediction considered self-supervised learning?",
      "stem_format": "plain_text",
      "choices_format": "plain_text",
      "choices": [
        "Human annotators mark every sentence with a class before training begins.",
        "The raw text supplies both the context and the target token without manual labels.",
        "The model receives paired images and captions rather than text sequences.",
        "The objective requires a manually labeled positive and negative face pair."
      ],
      "answer_index": 1,
      "explanation": "The training target is already present in the sequence: earlier tokens form the input context and the next token is the target.",
