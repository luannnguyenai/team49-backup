      "type": "multiple_choice",
      "question": "A DQN implementation reaches a terminal state after taking an action. The target should be set to what value form?",
      "stem_format": "plain_text",
      "choices_format": "plain_text",
      "choices": [
        "Immediate reward plus gamma times the next maximum Q-value",
        "Immediate reward without any discounted future Q-value",
        "The average Q-value over the previous replay mini-batch",
        "Zero for every terminal transition regardless of reward"
      ],
      "answer_index": 1,
      "explanation": "At a terminal state there is no future state to bootstrap from, so the target is just the immediate reward.",
      "answer_explanation_format": "plain_text",
