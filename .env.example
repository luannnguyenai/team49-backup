# =============================================================================
# .env.example - Copy to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=your_gemini_api_key
SEMANTIC_SCHOLAR_API_KEY=s2k-3Rip4TY0E1Y6G5AvuEZnUrxlx4XC6BMixH3ZNLvL
GUARDRAIL_ROUTER_BASE_URL=https://router.a20-app-049.io.vn/v1
GUARDRAIL_ROUTER_MODEL=guardrail-router-merged
GUARDRAIL_ROUTER_API_KEY=aivntop1gogo

# MODEL_PROVIDER: openai | google_genai | anthropic
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano
MODEL_REASONING_EFFORT=medium
MODEL_EXTRA_KWARGS={}
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
GEMINI_REQUESTS_PER_MINUTE=15

# -----------------------------------------------------------------------------
# Optional self-hosted large response model
# -----------------------------------------------------------------------------
QWEN35_4B_MODEL=qwen3.5-4b-lora
QWEN35_4B_BASE_URL=https://vllm.a20-app-049.io.vn/v1
QWEN35_4B_API_KEY=EMPTY
CHAT_MODEL_HEALTH_TIMEOUT_SECONDS=8.0

# -----------------------------------------------------------------------------
# Shared Guardrail Router
# -----------------------------------------------------------------------------
# The guardrail router runs before Tutor and Agent answer generation.
# Empty GUARDRAIL_ROUTER_BASE_URL skips the Cloudflare/vLLM hop and falls back
# to MODEL_PROVIDER + FAST_MODEL.
GUARDRAIL_ROUTER_BASE_URL=https://router.a20-app-049.io.vn/v1
GUARDRAIL_ROUTER_MODEL=guardrail-router-merged
GUARDRAIL_ROUTER_API_KEY=change_me_router_token
GUARDRAIL_ROUTER_TIMEOUT_SECONDS=10.0
GUARDRAIL_ROUTER_UNHEALTHY_COOLDOWN_SECONDS=60.0
GUARDRAIL_ROUTER_MAX_TOKENS=96

# Optional: only set when Cloudflare Access protects the router hostname.
GUARDRAIL_ROUTER_CF_ACCESS_CLIENT_ID=
GUARDRAIL_ROUTER_CF_ACCESS_CLIENT_SECRET=

# Optional: empty means fallback uses MODEL_PROVIDER + FAST_MODEL.
GUARDRAIL_ROUTER_FALLBACK_PROVIDER=
GUARDRAIL_ROUTER_FALLBACK_MODEL=

# -----------------------------------------------------------------------------
# External research search mode
# -----------------------------------------------------------------------------
EXTERNAL_RESEARCH_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
GUARDRAIL_ROUTER_BASE_URL=https://router.a20-app-049.io.vn/v1
GUARDRAIL_ROUTER_MODEL=guardrail-router-merged
GUARDRAIL_ROUTER_API_KEY=aivntop1gogo

# -----------------------------------------------------------------------------
# Database / Redis
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@localhost:5433/ai_learning
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

AGENT_GRAPH_CHECKPOINTER_BACKEND=postgres
AGENT_GRAPH_CHECKPOINTER_SETUP=true

# -----------------------------------------------------------------------------
# Security / auth
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_min_32_chars_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
ASSET_URL_EXPIRE_SECONDS=900
ADMIN_TOKEN=

# Optional password reset email delivery via Gmail SMTP.
GMAIL_APP_PASSWORD=
EMAIL_FROM=
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# API / app runtime
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Frontend runtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GRAFANA_HOST=http://localhost:3001
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=http://localhost:9090
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# AI prompt logging hooks
# -----------------------------------------------------------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=change-your-api-key
AI_LOG_DIR=.ai-log

# Advanced tuning flags such as KG_* / IRT_* / canonical cutover flags already
# have production-safe defaults in src/config.py. Add them to .env only when
# you intentionally need to override the defaults.
