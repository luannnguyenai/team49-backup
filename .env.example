# =============================================================================
# .env.example - Copy to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -- LLM API Keys --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GLM_API_KEY=your_glm_api_key

# -- LLM Provider (google_genai | openai | anthropic) -------------------------
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano

GUARDRAIL_ROUTER_BASE_URL=https://router.example.com/v1
GUARDRAIL_ROUTER_MODEL=guardrail-router-merged
GUARDRAIL_ROUTER_API_KEY=change_me_router_token
GUARDRAIL_ROUTER_TIMEOUT_SECONDS=10.0
GUARDRAIL_ROUTER_UNHEALTHY_COOLDOWN_SECONDS=60.0
GUARDRAIL_ROUTER_MAX_TOKENS=96

EXTERNAL_RESEARCH_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=s2k-...
GEMINI_REQUESTS_PER_MINUTE=15
MODEL_EXTRA_KWARGS={}
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@localhost:5432/ai_learning

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# -- Security / JWT -----------------------------------------------------------
SECRET_KEY=change_me_min_32_chars_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
ASSET_URL_EXPIRE_SECONDS=900
ADMIN_TOKEN=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# -- SQLAlchemy tuning --------------------------------------------------------
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -- App ----------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# -- Service ports (local dev) ------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -- Next.js Frontend ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
API_INTERNAL_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_GRAFANA_HOST=http://localhost:3001
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=http://localhost:9090
WATCHPACK_POLLING=true

# -- Langfuse tracing / observability ----------------------------------------
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -- Knowledge graph / recommendation tuning ---------------------------------
KG_PHASE=0
KG_MASTERY_SKIP_THRESHOLD=0.7
KG_MASTERY_REVIEW_THRESHOLD=0.4
KG_SHORTCUT_MASTERY_THRESHOLD=0.8
KG_SHORTCUT_HOURS_FACTOR=0.4
KG_PATH_WEEK_BUFFER=0.2
KG_BUCKET_WEIGHTS={"easy":1.0,"medium":1.3,"hard":1.6}
KG_RECSYS_WEIGHTS={"mastery_gap":0.35,"prereq_ready":0.25,"transfer_boost":0.2,"goal_distance":0.15,"freshness":0.05}

# -- Canonical runtime feature flags -----------------------------------------
WRITE_GOAL_PREFERENCES_ENABLED=true
WRITE_LEARNER_MASTERY_KP_ENABLED=true
WRITE_WAIVED_UNITS_ENABLED=true
WRITE_PLANNER_AUDIT_ENABLED=true
READ_GOAL_PREFERENCES_ENABLED=true
READ_LEARNER_MASTERY_KP_ENABLED=true
READ_CANONICAL_QUESTIONS_ENABLED=true
WRITE_CANONICAL_INTERACTIONS_ENABLED=true
READ_CANONICAL_PLANNER_ENABLED=true

# -- Placement assessment strategies -----------------------------------------
COLD_START_MODE=spread_by_prior
IRT_MIN_AVG_RESPONSES=200
IRT_MIN_CALIBRATED_RATIO=0.8
IRT_MAX_MEDIAN_SE_B=0.3
IRT_EXPOSURE_CAP_HOURS=24
IRT_USE_2PL=false

# -- AI Hook Logging ----------------------------------------------------------
AI_LOG_SERVER=https://ai-logs.example.com/api/ingest
AI_LOG_API_KEY=change_me_ai_log_key
AI_LOG_DIR=.ai-log

# -- Email / app extras -------------------------------------------------------
EMAIL_FROM=noreply@example.com
FRONTEND_BASE_URL=http://localhost:3000
GMAIL_APP_PASSWORD=change_me_gmail_app_password

# -- Optional local model/cache access ---------------------------------------
HF_TOKEN=hf_...
