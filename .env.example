# =============================================================================
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to version control!
# Backend: FastAPI + SQLAlchemy async + Redis + LangChain/LangGraph
# Frontend/Admin: Next.js 14 + Grafana/LangFuse embeds
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=your_gemini_api_key

# ── LLM Provider (google_genai | openai | anthropic) ──────────────────────────
# Default local setup uses Gemini because start.sh validates GEMINI_API_KEY.
# To use OpenAI instead: MODEL_PROVIDER=openai, DEFAULT_MODEL=<openai model>, FAST_MODEL=<openai model>, and set OPENAI_API_KEY.
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano
# Provider-specific JSON kwargs for non-OpenAI thinking controls when needed.
# Example: MODEL_EXTRA_KWARGS={"thinking_budget":1024}
MODEL_EXTRA_KWARGS={}
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Provider API keys (set the one(s) you actually use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Database / Redis ──────────────────────────────────────────────────────────
# Local app runtime reads the full URLs below.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@localhost:5433/ai_learning
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# Docker Compose / local infra convenience vars
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# ── Security / auth ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_min_32_chars_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
ASSET_URL_EXPIRE_SECONDS=900

# Forgot password email delivery via Gmail SMTP
GMAIL_APP_PASSWORD=
EMAIL_FROM=
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ── API / app runtime ─────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Local dev ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Frontend runtime ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional for host-based local Next.js dev. In Docker Compose this is injected automatically.
API_INTERNAL_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# Admin / observability embeds
NEXT_PUBLIC_GRAFANA_HOST=http://localhost:3001
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_URL=http://localhost:9090

# Windows/WSL Docker dev hot reload helper
WATCHPACK_POLLING=true

# ── LangFuse tracing (optional, fail-safe when blank) ────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Backward-compatible alias for older local configs / code paths
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Knowledge graph / recommendation tuning ──────────────────────────────────
KG_PHASE=0
ADMIN_TOKEN=
KG_MASTERY_SKIP_THRESHOLD=0.7
KG_MASTERY_REVIEW_THRESHOLD=0.4
KG_SHORTCUT_MASTERY_THRESHOLD=0.8
KG_SHORTCUT_HOURS_FACTOR=0.4
KG_PATH_WEEK_BUFFER=0.2
KG_BUCKET_WEIGHTS={"easy":1.0,"medium":1.3,"hard":1.6}
KG_RECSYS_WEIGHTS={"mastery_gap":0.35,"prereq_ready":0.25,"transfer_boost":0.2,"goal_distance":0.15,"freshness":0.05}

# Canonical runtime feature flags
WRITE_GOAL_PREFERENCES_ENABLED=true
WRITE_LEARNER_MASTERY_KP_ENABLED=true
WRITE_WAIVED_UNITS_ENABLED=true
WRITE_PLANNER_AUDIT_ENABLED=true
READ_GOAL_PREFERENCES_ENABLED=true
READ_LEARNER_MASTERY_KP_ENABLED=true
READ_CANONICAL_QUESTIONS_ENABLED=true
WRITE_CANONICAL_INTERACTIONS_ENABLED=true
READ_CANONICAL_PLANNER_ENABLED=true

# Placement assessment strategies
# random_uniform | spread_by_prior | irt_adaptive | auto
COLD_START_MODE=spread_by_prior
IRT_MIN_AVG_RESPONSES=200
IRT_MIN_CALIBRATED_RATIO=0.8
IRT_MAX_MEDIAN_SE_B=0.3
IRT_EXPOSURE_CAP_HOURS=24
IRT_USE_2PL=false

# ── AI prompt logging hooks ───────────────────────────────────────────────────
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=change-your-api-key
AI_LOG_DIR=.ai-log

