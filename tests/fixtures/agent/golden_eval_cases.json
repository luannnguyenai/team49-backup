        "citation_should_include_any": ["YOLO", "Single-stage"],
        "answer_should_communicate": [
          "YOLO is covered as a single-stage detector",
          "image grid / bounding boxes / objectness / class probabilities",
          "thresholding or NMS if supported by the retrieved source"
