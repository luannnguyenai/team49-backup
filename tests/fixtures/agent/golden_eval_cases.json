{
  "version": 1,
  "description": "Reviewable golden evaluation scenarios for the /agent ReAct RAG flow. These cases are product contracts, not prompt examples or production keyword rules.",
  "review_rules": [
    "Use these cases to review expected behavior, not to train production code to match exact phrases.",
    "Do not copy fixture terms into production routing logic, synonym maps, or canned response branches.",
    "When behavior changes intentionally, update the case expectation and explain why in PR review.",
    "Runtime code must still rely on structured model decisions, tool evidence, and policy validation."
  ],
  "defaults": {
    "current_path_first": true,
    "title_first_retrieval": true,
    "no_domain_keyword_maps": true,
    "answer_language_policy": "Respond naturally in the user's language or mixed-language style; do not force English or Vietnamese.",
    "evidence_policy": "Only answer from validated tool evidence. If evidence is missing or only context-level, say so naturally and do not invent facts."
  },
